{
  "name": "rranime",
  "version": "1.0",
  "private": true,
  "description": "Anime Forums & Discussions",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "app": "npm --workspace client run start",
    "app:web": "npm --workspace client run web",
    "app:export": "npm --workspace client run export:web",
    "app:prebuild": "npm --workspace client run prebuild",
    "app:android": "npm --workspace client run run:android",
    "app:ios": "npm --workspace client run run:ios"
  },
  "workspaces": ["client"],
  "dependencies": {
    "axios": "^1.20.0",
    "cron": "^4.4.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "vhost": "^3.0.2"
  }
}
